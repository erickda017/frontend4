# Copie este arquivo para ".env" (mesma pasta) e preencha com os valores reais
# para rodar o frontend localmente com "npm run dev".
#
# Em produção (Vercel), estas MESMAS variáveis precisam ser configuradas em
# Project Settings -> Environment Variables no painel da Vercel — arquivos
# .env NUNCA são enviados para o Git nem lidos pela Vercel automaticamente.
# Depois de configurar/alterar, é preciso fazer um novo deploy (Redeploy) para
# o build pegar o valor novo — variáveis VITE_* são "gravadas" no JS estático
# durante o build, não lidas em tempo de execução no navegador.

# URL pública do backend Node (Express), sem barra "/" no final.
# Em dev local: http://localhost:3000 (backend rodando na mesma máquina).
# Em produção: a URL do serviço no Render, ex:
#   https://backend42-xos7.onrender.com
# SEM isso configurado na Vercel, o build cai no valor padrão de dev
# (http://localhost:3000) — o site publicado tenta chamar "localhost" do
# navegador de quem está visitando, o que NUNCA funciona, e a UI mostra
# "Não consegui falar com o servidor" mesmo com o backend no ar.
VITE_API_URL=http://localhost:3000

# Mesmo projeto Supabase usado pelo backend (variáveis SUPABASE_URL /
# SUPABASE_ANON_KEY no backend/.env e no Render) — Project Settings -> API
# no painel do Supabase.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
